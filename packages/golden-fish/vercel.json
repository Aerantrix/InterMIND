{
  "cleanUrls": true,

  "devCommand": "pnpm exec vitepress dev docs --port $PORT",

  "functions": {
    "api/onboarding.ts": {
      "includeFiles": "api/config/**"
    }
  },

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=31536000, immutable"
        }
      ]
    }
  ]
}
